## .gitignore para proyecto .NET / ASP.NET Core

# Carpetas de build
bin/
obj/

# Base de datos SQLite — nunca subir datos de desarrollo
*.db
*.db-shm
*.db-wal

# Configuración local con secrets (connection strings reales, API keys)
# appsettings.Development.json SÍ se versiona: tiene solo claves de desarrollo
# (JWT, ApiKey entre servicios, Admin de prueba) para que el proyecto levante al
# clonarlo. Los valores reales de otros entornos van en variables de entorno o user-secrets.
appsettings.Local.json
secrets.json

# Visual Studio
.vs/
*.user
*.suo

# VS Code C# Dev Kit — caché del language service, se regenera sola
*.lscache

# Rider
.idea/

# VS Code (opcional — si lo comparten en equipo, eliminen esta línea)
.vscode/

# NuGet
*.nupkg
.nuget/

# Logs
*.log
logs/

# Archivos del sistema
.DS_Store
Thumbs.db